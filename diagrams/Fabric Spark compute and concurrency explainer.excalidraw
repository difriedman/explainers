    {
      "id": "zXDXIGmU8f31UW9Ubg1A-",
      "type": "text",
      "x": -3591.49113087549,
      "y": 2122.7696288839766,
      "width": 785.319580078125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
