      "text": "Bursting = 3X multiplier",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bursting = 3X multiplier",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fE5Nj2lfFfKkoV7y-DUxm",
      "type": "text",
      "x": -3527.9421046708626,
      "y": 1903.463185511143,
      "width": 461.7396545410156,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bgt",
      "roundness": null,
      "seed": 1036423122,
      "version": 390,
      "versionNonce": 1624272361,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "jwJwW4DRNpONFOQfpqpmE",
          "type": "arrow"
        }
      ],
      "updated": 1791218124492,
      "link": null,
      "locked": false,
      "text": "F16 --> 32 standard vCores, 96 w/bursting\nF32 --> 64 standard vCores, 192 w/bursting\nF64 --> 128 standard vCores, 384 w/bursting\nF128 --> 256 standard vCores, 768 w/bursting",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "F16 --> 32 standard vCores, 96 w/bursting\nF32 --> 64 standard vCores, 192 w/bursting\nF64 --> 128 standard vCores, 384 w/bursting\nF128 --> 256 standard vCores, 768 w/bursting",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sotxUPZv1GrHQgGF6R2Aj",
      "type": "text",
      "x": -3588.8632914177756,
      "y": 2239.741580088294,
      "width": 830.0852062981828,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bgu",
      "roundness": null,
      "seed": 174819026,
      "version": 905,
      "versionNonce": 623149351,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791218124492,
      "link": null,
      "locked": false,
      "text": "* Theoretically, with absolutely nothing else running on the F64 capacity. Capacity is shared across all\nspark sessions and all workloads (Power BI, RTI, etc.).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Theoretically, with absolutely nothing else running on the F64 capacity. Capacity is shared across all spark sessions and all workloads (Power BI, RTI, etc.).",
      "autoResize": false,
      "lineHeight": 1.25
    },
