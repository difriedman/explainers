    {
      "id": "Iz4J7utmglhJ1LcaEL4qP",
      "type": "text",
      "x": 58,
      "y": 2061.3999999999996,
      "width": 329.84000000000003,
      "height": 251.875,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "7hSe4vg2V76a1PKvsLrgO-g"
      ],
      "frameId": null,
      "index": "b1L",
      "roundness": null,
      "seed": 573558464,
      "version": 1,
      "versionNonce": 1774357473,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790722832611,
      "link": null,
      "locked": false,
      "text": "F64 capacity — Starter Pool\nMedium nodes only (8 vCores/node)\nDefault max nodes/session: 10\n(admin can raise up to 16 on F64)\n\n2 interactive notebooks land on\npre-warmed capacity, each autoscaling\nto ~3 nodes for typical exploration:\n2 × 3 nodes × 8 vCores = 48 VCores\n\nWell within F64's 128 VCore base —\nbest-effort ~5–10s start if pre-warmed\ncapacity happens to be free",
      "fontSize": 15.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "F64 capacity — Starter Pool\nMedium nodes only (8 vCores/node)\nDefault max nodes/session: 10\n(admin can raise up to 16 on F64)\n\n2 interactive notebooks land on\npre-warmed capacity, each autoscaling\nto ~3 nodes for typical exploration:\n2 × 3 nodes × 8 vCores = 48 VCores\n\nWell within F64's 128 VCore base —\nbest-effort ~5–10s start if pre-warmed\ncapacity happens to be free",
      "autoResize": true,
      "lineHeight": 1.25
    },
