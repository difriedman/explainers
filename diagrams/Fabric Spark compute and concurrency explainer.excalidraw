      "versionNonce": 259407751,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791218353359,
      "link": null,
      "locked": false,
      "text": "• Microsoft-managed, best-effort\n• No schedule — always on, not guaranteed\n• ~5–10s when pre-warmed capacity exists\n• High regional demand, Private Link, or\n  Managed VNet → fallback to on-demand\n  (~2–5 min)",
      "fontSize": 15.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Microsoft-managed, best-effort\n• No schedule — always on, not guaranteed\n• ~5–10s when pre-warmed capacity exists\n• High regional demand, Private Link, or\n  Managed VNet → fallback to on-demand\n  (~2–5 min)",
      "autoResize": true,
      "lineHeight": 1.25
    },
