    {
      "id": "GDinouxZjugnDD57Nb5sr",
      "type": "text",
      "x": 478,
      "y": 1721.3999999999999,
      "width": 295.12,
      "height": 193.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "t5YdIngBaVbVJBMQKnY8q-g"
      ],
      "frameId": null,
      "index": "b1B",
      "roundness": null,
      "seed": 529696726,
      "version": 1,
      "versionNonce": 1491036258,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790719070514,
      "link": null,
      "locked": false,
      "text": "3 notebooks, each fixed at 4 nodes\n(Medium, 8 vCores/node — autoscale\nand dynamic allocation OFF)\n\n3 sessions × 4 nodes × 8 vCores\n= 96 VCores consumed\n\nOn an F64 (128 VCores base):\nfits comfortably — no bursting\nneeded, headroom for more",
      "fontSize": 15.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3 notebooks, each fixed at 4 nodes\n(Medium, 8 vCores/node — autoscale\nand dynamic allocation OFF)\n\n3 sessions × 4 nodes × 8 vCores\n= 96 VCores consumed\n\nOn an F64 (128 VCores base):\nfits comfortably — no bursting\nneeded, headroom for more",
      "autoResize": true,
      "lineHeight": 1.25
    },
