      "seed": 405200207,
      "version": 1,
      "versionNonce": 1948730280,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790732239087,
      "link": null,
      "locked": false,
      "text": "Why (and Why Not) to Use It",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why (and Why Not) to Use It",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EfyDeBiV4MbpRql53qPG8",
      "type": "text",
      "x": 1296,
      "y": 3440,
      "width": 308.56,
      "height": 253.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "dDKBs174oWtnPMaHJeInE-g"
      ],
      "frameId": null,
      "index": "b1q",
      "roundness": null,
      "seed": 603579242,
      "version": 1,
      "versionNonce": 466268480,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790732239087,
      "link": null,
      "locked": false,
      "text": "• Removes Spark entirely from\n  contention with Power BI,\n  Warehouse, Real-Time Intelligence,\n  etc. on the same capacity\n• Good fit for bursty or unpredictable\n  Spark workloads you don't want\n  competing for the shared budget\n• Can let you downsize the main\n  Fabric capacity afterward, since\n  Spark no longer needs room there\n\nCaution: enabling, disabling, or\nlowering the CU limit CANCELS any\nSpark jobs currently running under it",
      "fontSize": 14.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Removes Spark entirely from\n  contention with Power BI,\n  Warehouse, Real-Time Intelligence,\n  etc. on the same capacity\n• Good fit for bursty or unpredictable\n  Spark workloads you don't want\n  competing for the shared budget\n• Can let you downsize the main\n  Fabric capacity afterward, since\n  Spark no longer needs room there\n\nCaution: enabling, disabling, or\nlowering the CU limit CANCELS any\nSpark jobs currently running under it",
      "autoResize": true,
      "lineHeight": 1.25
    },
