      "locked": false,
      "text": "Shared Spark VCore Capacity",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Shared Spark VCore Capacity",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HxNWFOCWdnrJi7sC4SFhb",
      "type": "text",
      "x": 58,
      "y": 1306.1999999999998,
      "width": 329.84000000000003,
      "height": 271.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3KL8bWR0rKcWWlEHPC6rl-g"
      ],
      "frameId": null,
      "index": "b0s",
      "roundness": null,
      "seed": 2089816871,
      "version": 2,
      "versionNonce": 1515700722,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790718119391,
      "link": null,
      "locked": false,
      "text": "• 1 capacity unit = 2 Spark VCores\n• Bursting: up to 3× purchased VCores\n\n   F32  →   64 VCores  (192 w/ burst)\n   F64  →  128 VCores  (384 w/ burst)\n   F128 →  256 VCores  (768 w/ burst)\n\n• Shared by ALL Spark items in ALL\n  workspaces on this capacity — not\n  just the pool you're tuning\n\nConcurrent sessions ≈\n  Total VCores (w/ burst) ÷ VCores per\n  currently active session",
      "fontSize": 15.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• 1 capacity unit = 2 Spark VCores\n• Bursting: up to 3× purchased VCores\n\n   F32  →   64 VCores  (192 w/ burst)\n   F64  →  128 VCores  (384 w/ burst)\n   F128 →  256 VCores  (768 w/ burst)\n\n• Shared by ALL Spark items in ALL\n  workspaces on this capacity — not\n  just the pool you're tuning\n\nConcurrent sessions ≈\n  Total VCores (w/ burst) ÷ VCores per\n  currently active session",
      "autoResize": true,
      "lineHeight": 1.25
    },
