      "boundElements": [],
      "updated": 1790718119391,
      "link": null,
      "locked": false,
      "text": "• Delay reason:\n  POOL_RESOURCE_NOT_AVAILABLE\n• No hydrated cluster available now\n• Standard provisioning: ~2–5 min\n  (+ library install if Quick mode)\n• Session still starts — just without\n  the warm-path speed",
      "fontSize": 15.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Delay reason:\n  POOL_RESOURCE_NOT_AVAILABLE\n• No hydrated cluster available now\n• Standard provisioning: ~2–5 min\n  (+ library install if Quick mode)\n• Session still starts — just without\n  the warm-path speed",
      "autoResize": true,
