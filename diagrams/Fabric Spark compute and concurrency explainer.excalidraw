    {
      "id": "K3VBTJG8A8HkGt25ZxgO4",
      "type": "text",
      "x": 56,
      "y": 3440,
      "width": 308.56,
      "height": 217.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "U5Rz38xJo2bcZVvQNFImv-g"
      ],
      "frameId": null,
      "index": "b1k",
      "roundness": null,
      "seed": 1422157678,
      "version": 1,
      "versionNonce": 1386360809,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790732239087,
      "link": null,
      "locked": false,
      "text": "• An OPT-IN, capacity-level billing\n  mode — turned on per Fabric capacity\n• Spark jobs stop drawing from the\n  shared capacity entirely and run on\n  dedicated SERVERLESS compute\n  instead\n• Billed pay-as-you-go: 0.5 CU-hour\n  per job, only while actively\n  running — no idle compute cost\n• Requires an F-SKU (F2+); not\n  available on P-SKUs or trial\n  capacities",
      "fontSize": 14.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• An OPT-IN, capacity-level billing\n  mode — turned on per Fabric capacity\n• Spark jobs stop drawing from the\n  shared capacity entirely and run on\n  dedicated SERVERLESS compute\n  instead\n• Billed pay-as-you-go: 0.5 CU-hour\n  per job, only while actively\n  running — no idle compute cost\n• Requires an F-SKU (F2+); not\n  available on P-SKUs or trial\n  capacities",
      "autoResize": true,
      "lineHeight": 1.25
    },
