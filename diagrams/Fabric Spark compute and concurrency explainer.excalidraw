      "boundElements": [],
      "updated": 1791218894178,
      "link": null,
      "locked": false,
      "text": "Pool = a configuration template (node size + scaling rules). \nCluster = the compute Fabric provisions from it for ONE session.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pool = a configuration template (node size + scaling rules). \nCluster = the compute Fabric provisions from it for ONE session.",
      "autoResize": true,
      "lineHeight": 1.25
    },
