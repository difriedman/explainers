      "index": "bgw",
      "roundness": null,
      "seed": 3729746,
      "version": 392,
      "versionNonce": 392676423,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791218124492,
      "link": null,
      "locked": false,
      "text": "F64 w/starter pool (medium nodes, 8 cores/node) has enough capacity* to run:\n\n        16 medium nodes x 24 hours  ~or~  42 medium nodes x 8 hours (bursting)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "F64 w/starter pool (medium nodes, 8 cores/node) has enough capacity* to run:\n\n        16 medium nodes x 24 hours  ~or~  42 medium nodes x 8 hours (bursting)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3MlvtqPYy5Xdyz5JAWrBD",
      "type": "rectangle",
      "x": -4027.5476397459224,
      "y": 1789.2342354890006,
      "width": 418.82170098388815,
      "height": 231.24087348900872,
      "angle": 0,
      "strokeColor": "#e8a800",
      "backgroundColor": "#fff9db",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PniED_0Ee8yMpDO2iYdeL"
      ],
