    {
      "id": "DTVHc6zeWiY34Wbz_P_TJ",
      "type": "text",
      "x": -3669.1114922687566,
      "y": 2779.0127308541105,
      "width": 355.88000000000005,
      "height": 116.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
