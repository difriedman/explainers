    },
    {
      "id": "1SOdNWayh9ERKd0qvEYhc",
      "type": "text",
      "x": 676,
      "y": 2990,
      "width": 300.44000000000005,
      "height": 199.375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PX7Okjlzz5p6uMuyvDIJR-g"
      ],
      "frameId": null,
      "index": "b1c",
      "roundness": null,
      "seed": 4397048,
      "version": 1,
      "versionNonce": 637410596,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790732239087,
      "link": null,
      "locked": false,
      "text": "F64: 128 VCores base, 384 with the\nfull 3× burst factor applied\n\nPool configured for the full 384\nVCores (e.g. Medium nodes × 48\nmax nodes):\n\n• One large job CAN consume all 384\n  VCores when nothing else is running\n• …or three 128-VCore jobs can run\n  at the same time instead",
      "fontSize": 14.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "F64: 128 VCores base, 384 with the\nfull 3× burst factor applied\n\nPool configured for the full 384\nVCores (e.g. Medium nodes × 48\nmax nodes):\n\n• One large job CAN consume all 384\n  VCores when nothing else is running\n• …or three 128-VCore jobs can run\n  at the same time instead",
      "autoResize": true,
      "lineHeight": 1.25
    },
