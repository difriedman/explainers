    {
      "id": "7Tqdz5dxcy0AC8XJsxV6X",
      "type": "text",
      "x": 1296,
      "y": 3411.2,
      "width": 272.16,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "dDKBs174oWtnPMaHJeInE-g"
      ],
      "frameId": null,
