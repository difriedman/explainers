      "isDeleted": false,
      "boundElements": [],
      "updated": 1791218936285,
      "link": null,
      "locked": false,
      "text": "• Elastic EXECUTOR count within\n  the nodes available to the session\n• Reserves min executors at submit;\n  grows to max under load\n• Disabled → fixed executor count,\n  no ramp-up delay",
      "fontSize": 15.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Elastic EXECUTOR count within\n  the nodes available to the session\n• Reserves min executors at submit;\n  grows to max under load\n• Disabled → fixed executor count,\n  no ramp-up delay",
      "autoResize": true,
      "lineHeight": 1.25
    },
