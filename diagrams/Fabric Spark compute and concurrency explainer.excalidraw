      "updated": 1790732239087,
      "link": null,
      "locked": false,
      "text": "Job-Level Bursting Control",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Job-Level Bursting Control",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Z4qGVxz4oqFlxWHYnN7I5",
      "type": "text",
      "x": 1296,
      "y": 2990,
      "width": 292.32000000000005,
      "height": 235.625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "8dQdYDwy7OvZVgs3LhPwY-g"
      ],
      "frameId": null,
      "index": "b1f",
      "roundness": null,
      "seed": 1060456631,
      "version": 1,
      "versionNonce": 1453823649,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790732239087,
      "link": null,
      "locked": false,
      "text": "Capacity admins can turn bursting\nOFF for individual jobs:\n\nAdmin portal → Capacity settings →\nData Engineering/Science → Spark\nCompute → Disable job-level bursting\n\n• ON (default): one job can\n  monopolize up to the full burst\n  ceiling, at the expense of others\n• OFF: one job is capped at BASE\n  VCores — fairer for multi-tenant\n  or high-concurrency workspaces",
      "fontSize": 14.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Capacity admins can turn bursting\nOFF for individual jobs:\n\nAdmin portal → Capacity settings →\nData Engineering/Science → Spark\nCompute → Disable job-level bursting\n\n• ON (default): one job can\n  monopolize up to the full burst\n  ceiling, at the expense of others\n• OFF: one job is capped at BASE\n  VCores — fairer for multi-tenant\n  or high-concurrency workspaces",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZdxLiVmzngXaZrBiJFXv0",
      "type": "text",
      "x": 40,
      "y": 3352,
      "width": 977.7600000000001,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#7048e8",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1g",
      "roundness": null,
      "seed": 779743238,
      "version": 1,
      "versionNonce": 1311939492,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790732239087,
      "link": null,
      "locked": false,
      "text": "Spark Autoscale (On-Demand Billing) — a Separate System from Pool Autoscale and Capacity Bursting",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Spark Autoscale (On-Demand Billing) — a Separate System from Pool Autoscale and Capacity Bursting",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Qjeq7Feek2Z2zqLrvk4Km",
      "type": "text",
      "x": 40,
      "y": 3378,
      "width": 902.7200000000001,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1h",
      "roundness": null,
      "seed": 1401427536,
      "version": 1,
      "versionNonce": 1875695410,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790732239087,
      "link": null,
      "locked": false,
      "text": "Same word, different mechanism: this is an opt-in, capacity-level BILLING mode — not the per-pool node slider covered above.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same word, different mechanism: this is an opt-in, capacity-level BILLING mode — not the per-pool node slider covered above.",
      "autoResize": true,
      "lineHeight": 1.25
    },
