    {
      "id": "jCIEwvJWIyD7u3mSpKyo2",
      "type": "text",
      "x": 1098,
      "y": 1306.1999999999998,
      "width": 329.84000000000003,
      "height": 193.75,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "MZpTktJaJAfo16hD8hP1j-g"
      ],
      "frameId": null,
      "index": "b0v",
      "roundness": null,
      "seed": 1665469080,
      "version": 2,
      "versionNonce": 411900014,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790718119391,
      "link": null,
      "locked": false,
      "text": "[TooManyRequestsForCapacity]  HTTP 430\n\n• Interactive notebooks: NOT queued —\n  rejected, or fall back to on-demand\n• Pipeline / scheduled / SJD jobs:\n  queued FIFO, retried, 24h expiry\n• A bigger live-pool cluster size or\n  cluster count here leaves less\n  headroom — more throttling for\n  everyone else sharing this capacity",
      "fontSize": 15.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[TooManyRequestsForCapacity]  HTTP 430\n\n• Interactive notebooks: NOT queued —\n  rejected, or fall back to on-demand\n• Pipeline / scheduled / SJD jobs:\n  queued FIFO, retried, 24h expiry\n• A bigger live-pool cluster size or\n  cluster count here leaves less\n  headroom — more throttling for\n  everyone else sharing this capacity",
      "autoResize": true,
      "lineHeight": 1.25
    },
