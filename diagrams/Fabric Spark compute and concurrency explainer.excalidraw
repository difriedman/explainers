    {
      "id": "RGD4fc2jDmt9qrnRBBtGa",
      "type": "text",
      "x": 1398,
      "y": 1721.3999999999999,
      "width": 321.16,
      "height": 213.125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "RoQowFgsH9R1YpX4nVrRt-g"
      ],
      "frameId": null,
      "index": "b1H",
