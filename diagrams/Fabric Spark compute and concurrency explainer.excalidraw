    {
      "id": "NcIFiqB0zRRlKghIAAxib",
      "type": "text",
      "x": -4008.8427216818245,
      "y": 3131.7951331602044,
      "width": 315.2267150878906,
      "height": 163.125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1S",
      "roundness": null,
      "seed": 1731427908,
      "version": 379,
      "versionNonce": 1080905001,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791221248144,
      "link": null,
      "locked": false,
      "text": "Starter Pool (Medium nodes only)\n  F2 / F4      →  1 node (fixed)\n  F8             →  2 nodes\n  F16            →  3 default / 4 max\n  F32           →  8 nodes\n  F64 / Trial  → 10 default / 16 max\n  F128          → 10 default / 32 max\n  F256          → 10 default / 64 max\n  F512–F8192 → 10 default / 128–200 max",
      "fontSize": 14.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Starter Pool (Medium nodes only)\n  F2 / F4      →  1 node (fixed)\n  F8             →  2 nodes\n  F16            →  3 default / 4 max\n  F32           →  8 nodes\n  F64 / Trial  → 10 default / 16 max\n  F128          → 10 default / 32 max\n  F256          → 10 default / 64 max\n  F512–F8192 → 10 default / 128–200 max",
      "autoResize": true,
      "lineHeight": 1.25
    },
