      "versionNonce": 648548071,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791218936285,
      "link": null,
      "locked": false,
      "text": "• Elastic NODE count, min ↔ max\n• 1 node reserved for the driver;\n  remaining nodes host executors (1:1)\n• Disabled → fixed node count,\n  applied from session start",
      "fontSize": 15.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Elastic NODE count, min ↔ max\n• 1 node reserved for the driver;\n  remaining nodes host executors (1:1)\n• Disabled → fixed node count,\n  applied from session start",
      "autoResize": true,
      "lineHeight": 1.25
    },
