      "seed": 513047187,
      "version": 1,
      "versionNonce": 586916791,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790719070514,
      "link": null,
      "locked": false,
      "text": "2 heavy sessions, Large nodes,\nautoscaled to 8 nodes each:\n2 × 8 × 16 = 256 VCores\n\n+ 4 lightweight notebooks sharing\nONE High Concurrency session on\nSmall nodes (2 nodes × 4 vCores)\n= 8 VCores (instead of 4 sessions)\n\nTotal ≈ 264 VCores — fits an F128\nbase (256 + burst) without throttling",
      "fontSize": 15.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2 heavy sessions, Large nodes,\nautoscaled to 8 nodes each:\n2 × 8 × 16 = 256 VCores\n\n+ 4 lightweight notebooks sharing\nONE High Concurrency session on\nSmall nodes (2 nodes × 4 vCores)\n= 8 VCores (instead of 4 sessions)\n\nTotal ≈ 264 VCores — fits an F128\nbase (256 + burst) without throttling",
      "autoResize": true,
      "lineHeight": 1.25
    },
