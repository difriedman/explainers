      "link": null,
      "locked": false,
      "text": "Real-Time Intelligence: generate and\ntune KQL queries, help with time-\nwindowed summaries and filters, and\naccelerate Eventhouse exploration\npatterns.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Real-Time Intelligence: generate and tune KQL queries, help with time-windowed summaries and filters, and accelerate Eventhouse exploration patterns.",
      "autoResize": false,
      "lineHeight": 1.25
    },
