      "isDeleted": false,
      "boundElements": null,
      "updated": 1794420105167,
      "link": null,
      "locked": false,
      "text": "TLS creates a secure channel over the internet\nEncrypts application traffic in both directions\n * Intercepted traffic is unreadable and tampering is detected\nAuthenticates the server using certificates\nProtects credentials and tokens\nRejects clients that can't negotiate TLS 1.2+",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TLS creates a secure channel over the internet\nEncrypts application traffic in both directions\n * Intercepted traffic is unreadable and tampering is detected\nAuthenticates the server using certificates\nProtects credentials and tokens\nRejects clients that can't negotiate TLS 1.2+",
      "autoResize": true,
      "lineHeight": 1.25
    },
